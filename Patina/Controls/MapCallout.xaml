<UserControl x:Class="Patina.Controls.MapCallout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Patina.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:utu="using:Uno.Toolkit.UI">
  <!-- Inherits the page's DataContext: expects Selected (artwork feed) and ClearSelection (command). -->
  <mvux:FeedView Source="{Binding Selected}" IsTabStop="False" MaxWidth="380">
    <mvux:FeedView.ValueTemplate>
      <DataTemplate>
        <utu:CardContentControl Style="{StaticResource ElevatedCardContentControlStyle}"
                                HorizontalAlignment="Stretch"
                                Content="{Binding}">
          <utu:CardContentControl.ContentTemplate>
            <DataTemplate>
              <Grid Padding="20,16" RowSpacing="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Data.Accession}" Style="{StaticResource AccessionTextStyle}" />
                  <TextBlock Text="{Binding Data.Title}" Style="{StaticResource TitleLarge}" TextWrapping="WrapWholeWords" />
                  <TextBlock Text="{Binding Data.Site}" Style="{StaticResource MutedBodyTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}"
                        x:Uid="Map_CloseCallout"
                        AutomationProperties.Name="Close"
                        Command="{Binding Parent.ClearSelection}">
                  <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
                <controls:ConditionStrip Grid.Row="1" Grade="{Binding Data.Grade}" />
                <Button Grid.Row="2" Grid.ColumnSpan="2"
                        x:Uid="Map_OpenRecord" Content="Open record"
                        Style="{StaticResource FilledButtonStyle}"
                        HorizontalAlignment="Stretch"
                        uen:Navigation.Request="Artwork"
                        uen:Navigation.Data="{Binding Data}" />
              </Grid>
            </DataTemplate>
          </utu:CardContentControl.ContentTemplate>
        </utu:CardContentControl>
      </DataTemplate>
    </mvux:FeedView.ValueTemplate>
    <mvux:FeedView.NoneTemplate>
      <DataTemplate />
    </mvux:FeedView.NoneTemplate>
    <mvux:FeedView.ProgressTemplate>
      <DataTemplate />
    </mvux:FeedView.ProgressTemplate>
    <mvux:FeedView.ErrorTemplate>
      <DataTemplate />
    </mvux:FeedView.ErrorTemplate>
  </mvux:FeedView>
</UserControl>
