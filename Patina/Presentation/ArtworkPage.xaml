<Page x:Class="Patina.Presentation.ArtworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Patina.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <DataTemplate x:Key="TreatmentRowTemplate">
      <Grid Padding="0,10" ColumnSpacing="12" AutomationProperties.Name="{Binding Title}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" Style="{StaticResource TitleSmall}" TextWrapping="WrapWholeWords" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Priority, Converter={StaticResource EnumText}}" Style="{StaticResource LabelMedium}"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
            <TextBlock Text="·" Style="{StaticResource LabelMedium}" />
            <TextBlock Text="{Binding Status, Converter={StaticResource EnumText}}" Style="{StaticResource LabelMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            <TextBlock Text="{Binding ScheduledFor, Converter={StaticResource DateText}}" Style="{StaticResource LabelMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       Visibility="{Binding ScheduledFor, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
          </StackPanel>
        </StackPanel>
        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding Title}" utu:SafeArea.Insets="Top" />

    <mvux:FeedView x:Name="DossierFeed" Grid.Row="1" Source="{Binding Dossier}" IsTabStop="False">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ScrollViewer utu:SafeArea.Insets="Bottom">
            <Grid controls:Entrance.IsEnabled="True" Padding="0,0,0,32">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Anchor: the photograph, full-bleed. Responsive values live on the panels: ColumnDefinition is not a FrameworkElement. -->
              <StackPanel Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}">
                <Grid Height="{utu:Responsive Narrowest=240, Wide=380}" Background="{ThemeResource SurfaceVariantBrush}">
                  <Image controls:PhotoSource.FileName="{Binding Data.Cover.FileName}" Stretch="UniformToFill"
                         AutomationProperties.Name="Cover photograph" />
                  <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                              Visibility="{Binding Data.Cover, Converter={StaticResource VisibleWhen}, ConverterParameter=invert, FallbackValue=Collapsed}">
                    <FontIcon Glyph="&#xE722;" FontSize="28" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock x:Uid="Artwork_NoPhotoTitle" Text="No photograph yet" Style="{StaticResource TitleSmall}" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="Artwork_NoPhotoBody" Text="Photos added during a survey become the record photograph."
                               Style="{StaticResource MutedBodyTextStyle}" TextAlignment="Center" MaxWidth="280" />
                  </StackPanel>
                </Grid>

                <StackPanel Padding="24,24,24,0" Spacing="20" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
                  <controls:TombstoneLabel Accession="{Binding Data.Artwork.Accession}"
                                           Title="{Binding Data.Artwork.Title}"
                                           Byline="{Binding Data.Artwork, Converter={StaticResource BylineText}}"
                                           Place="{Binding Data.Artwork, Converter={StaticResource PlaceText}}" />

                  <StackPanel Spacing="8">
                    <TextBlock x:Uid="Artwork_ConditionHeading" Text="Condition" Style="{StaticResource EyebrowTextStyle}" />
                    <controls:ConditionStrip Grade="{Binding Data.Summary.Grade}" Style="{StaticResource LargeConditionStripStyle}" />
                    <TextBlock Text="{Binding Data.Summary, Converter={StaticResource DueText}}" Style="{StaticResource TitleSmall}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock x:Uid="Artwork_LastSurveyed" Text="Last surveyed" Style="{StaticResource MutedBodyTextStyle}" />
                      <TextBlock Text="{Binding Data.Summary.LastSurveyed, Converter={StaticResource DateText}}" Style="{StaticResource MutedBodyTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Data, Converter={StaticResource IntervalText}}" Style="{StaticResource MutedBodyTextStyle}" />
                  </StackPanel>

                  <Button Content="{Binding Data, Converter={StaticResource SurveyActionText}}"
                          Command="{Binding Parent.StartSurvey}"
                          Style="{StaticResource FilledButtonStyle}"
                          HorizontalAlignment="{utu:Responsive Narrowest=Stretch, Normal=Left}"
                          AutomationProperties.AutomationId="StartSurvey" />

                  <TextBlock Text="{Binding Data.Artwork.Description}" Style="{StaticResource BodyLarge}" TextWrapping="WrapWholeWords" />
                </StackPanel>
              </StackPanel>

              <!-- Support: open work and history. Beside the anchor at Wide, below it otherwise. -->
              <StackPanel Grid.Row="{utu:Responsive Narrowest=1, Wide=0}"
                          Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                          Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}"
                          Padding="{utu:Responsive Narrowest='24,32,24,0', Wide='8,32,32,0'}"
                          Spacing="28"
                          MaxWidth="{StaticResource ContentMaxWidth}">
                <StackPanel Spacing="4">
                  <TextBlock x:Uid="Artwork_OpenTreatments" Text="Open treatments" Style="{StaticResource SectionTitleTextStyle}" />
                  <TextBlock x:Uid="Artwork_NoOpenTreatments" Text="Nothing open. Serious and urgent findings become treatments when a survey is submitted."
                             Style="{StaticResource MutedBodyTextStyle}"
                             Visibility="{Binding Data.OpenTreatments, Converter={StaticResource VisibleWhen}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                  <ListView ItemsSource="{Binding Data.OpenTreatments}"
                            ItemTemplate="{StaticResource TreatmentRowTemplate}"
                            SelectionMode="None" IsItemClickEnabled="True"
                            uen:Navigation.Request="Treatment"
                            AutomationProperties.AutomationId="OpenTreatmentList" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock x:Uid="Artwork_History" Text="Condition history" Style="{StaticResource SectionTitleTextStyle}" />
                  <TextBlock x:Uid="Artwork_NoHistory" Text="Never surveyed. The first survey sets the grade and the survey schedule."
                             Style="{StaticResource MutedBodyTextStyle}"
                             Visibility="{Binding Data.Surveys, Converter={StaticResource VisibleWhen}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                  <ItemsControl ItemsSource="{Binding Data.Surveys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="6" Padding="0,12">
                          <utu:Divider Foreground="{ThemeResource OutlineVariantBrush}" Margin="0,0,0,8" />
                          <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Date, Converter={StaticResource DateText}}" Style="{StaticResource TitleSmall}" />
                              <TextBlock Text="{Binding Converter={StaticResource SurveyMetaText}}" Style="{StaticResource MutedBodyTextStyle}" />
                            </StackPanel>
                            <controls:ConditionStrip Grid.Column="1" Grade="{Binding Grade}" VerticalAlignment="Top" />
                          </Grid>
                          <TextBlock Text="{Binding Notes}" Style="{StaticResource BodyMedium}" TextWrapping="WrapWholeWords"
                                     Visibility="{Binding Notes, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                          <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource FindingText}}" Style="{StaticResource BodySmall}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4"
                            Visibility="{Binding Data.CompletedTreatments, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                  <TextBlock x:Uid="Artwork_CompletedTreatments" Text="Completed treatments" Style="{StaticResource SectionTitleTextStyle}" />
                  <ListView ItemsSource="{Binding Data.CompletedTreatments}"
                            ItemTemplate="{StaticResource TreatmentRowTemplate}"
                            SelectionMode="None" IsItemClickEnabled="True"
                            uen:Navigation.Request="Treatment" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <ContentControl ContentTemplate="{StaticResource ListProgressTemplate}" Padding="24,0" />
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>
      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel Spacing="12" Padding="24,32">
            <TextBlock x:Uid="Artwork_GoneTitle" Text="This record is no longer in the collection" Style="{StaticResource TitleLarge}" />
            <TextBlock x:Uid="Artwork_GoneBody" Text="It may have been removed by an import. Go back to the collection." Style="{StaticResource MutedBodyTextStyle}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Spacing="12" Padding="24,32">
            <TextBlock x:Uid="Artwork_ErrorTitle" Text="This record could not be opened" Style="{StaticResource TitleLarge}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedBodyTextStyle}" />
            <Button x:Uid="Common_Retry" Content="Try again" Style="{StaticResource FilledButtonStyle}"
                    Command="{Binding Refresh, ElementName=DossierFeed}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
