<Page x:Class="Patina.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    WORKAROUND(ResponsiveExtension does not reconnect after Unloaded): this page is cached
    (NavigationCacheMode=Required) and leaves the visual tree whenever a detail page opens in the shell frame.
    Toolkit 9.1 ResponsiveExtension disconnects on the host's Unloaded and never re-subscribes on the next Loaded
    (src/Uno.Toolkit.UI/Markup/ResponsiveExtension.cs, release/stable/9.1), so {utu:Responsive} values here froze
    after the first artwork was opened. AdaptiveTrigger states carry the same 800 px (Wide) breakpoint instead.
    Kept local to the cached pages; detail pages are recreated per navigation and keep {utu:Responsive}.
  -->
  <!-- xaml-lint: allow responsive - see WORKAROUND above -->
  <Grid uen:Region.Attached="True">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="800" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Rail.Visibility" Value="Visible" />
            <Setter Target="RailDivider.Visibility" Value="Visible" />
            <Setter Target="BottomBar.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Wide and up: vertical rail. The tab bar's own surface fills the rail; the wordmark sits on top of it. -->
    <Grid x:Name="Rail"
          Grid.RowSpan="2"
          utu:SafeArea.Insets="Left,Top,Bottom"
          Visibility="Collapsed">
      <utu:TabBar uen:Region.Attached="True"
                  Style="{StaticResource VerticalTabBarStyle}">
        <utu:TabBar.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- The vertical style spreads items over the full height; stack them under the wordmark instead -->
            <StackPanel Orientation="Vertical" Spacing="8" Margin="0,72,0,0" />
          </ItemsPanelTemplate>
        </utu:TabBar.ItemsPanel>
        <utu:TabBarItem x:Uid="Nav_Collection" uen:Region.Name="Collection" Content="Collection"
                        AutomationProperties.AutomationId="RailCollection">
          <utu:TabBarItem.Icon>
            <FontIcon Glyph="&#xE80F;" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
        <utu:TabBarItem x:Uid="Nav_Queue" uen:Region.Name="Queue" Content="Treatments"
                        AutomationProperties.AutomationId="RailQueue">
          <utu:TabBarItem.Icon>
            <FontIcon Glyph="&#xE90F;" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
        <utu:TabBarItem x:Uid="Nav_Settings" uen:Region.Name="Settings" Content="Settings"
                        AutomationProperties.AutomationId="RailSettings">
          <utu:TabBarItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </utu:TabBarItem.Icon>
        </utu:TabBarItem>
      </utu:TabBar>
      <TextBlock x:Uid="Main_Wordmark"
                 Text="Patina"
                 Margin="16,24,16,0"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center"
                 IsHitTestVisible="False"
                 Style="{StaticResource TitleLarge}"
                 FontFamily="{StaticResource DisplayLargeFontFamily}"
                 Foreground="{ThemeResource PrimaryBrush}" />
    </Grid>

    <Rectangle x:Name="RailDivider" Grid.RowSpan="2" Width="1" HorizontalAlignment="Right"
               Fill="{ThemeResource OutlineVariantBrush}"
               Visibility="Collapsed" />

    <!-- Route-based Visibility region: Collection / Queue / Settings are created by the navigator -->
    <Grid Grid.Column="1"
          uen:Region.Attached="True"
          uen:Region.Navigator="Visibility" />

    <!-- Below Wide: bottom tab bar -->
    <utu:TabBar x:Name="BottomBar"
                Grid.Row="1" Grid.ColumnSpan="2"
                uen:Region.Attached="True"
                Style="{StaticResource BottomTabBarStyle}">
      <utu:TabBarItem x:Uid="Nav_Collection" uen:Region.Name="Collection" Content="Collection"
                      AutomationProperties.AutomationId="TabCollection">
        <utu:TabBarItem.Icon>
          <FontIcon Glyph="&#xE80F;" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem x:Uid="Nav_Queue" uen:Region.Name="Queue" Content="Treatments"
                      AutomationProperties.AutomationId="TabQueue">
        <utu:TabBarItem.Icon>
          <FontIcon Glyph="&#xE90F;" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem x:Uid="Nav_Settings" uen:Region.Name="Settings" Content="Settings"
                      AutomationProperties.AutomationId="TabSettings">
        <utu:TabBarItem.Icon>
          <FontIcon Glyph="&#xE713;" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
    </utu:TabBar>
  </Grid>
</Page>
