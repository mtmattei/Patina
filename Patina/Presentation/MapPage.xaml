<Page x:Class="Patina.Presentation.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Patina.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <utu:NavigationBar x:Uid="Map_Title" Content="Collection map" utu:SafeArea.Insets="Top" />
    <Grid Grid.Row="1" utu:SafeArea.Insets="Bottom">
      <controls:ArtworkMap Artworks="{Binding Artworks}"
                           SelectedId="{Binding SelectedId, Mode=TwoWay}"
                           AutomationProperties.Name="Map of the collection" />
      <controls:MapCallout Margin="16" VerticalAlignment="Bottom" />
    </Grid>
  </Grid>
</Page>
