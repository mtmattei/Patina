<Page x:Class="Patina.Presentation.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Patina.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <DataTemplate x:Key="QueueRowTemplate">
      <Grid Padding="24,14" ColumnSpacing="16" AutomationProperties.Name="{Binding Title}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Priority, Converter={StaticResource EnumText}}" Style="{StaticResource LabelMedium}"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="4"
                        Visibility="{Binding IsLate, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
              <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource ErrorBrush}" />
              <TextBlock x:Uid="Queue_Late" Text="Late" Style="{StaticResource LabelMedium}" Foreground="{ThemeResource ErrorBrush}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TitleMedium}" TextWrapping="WrapWholeWords"
                     Foreground="{ThemeResource OnSurfaceBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding ArtworkTitle}" Style="{StaticResource MutedBodyTextStyle}" />
            <TextBlock Text="·" Style="{StaticResource MutedBodyTextStyle}" />
            <TextBlock Text="{Binding Accession}" Style="{StaticResource AccessionTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status, Converter={StaticResource EnumText}}" Style="{StaticResource LabelLarge}" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding ScheduledFor, Converter={StaticResource DateText}}" Style="{StaticResource MonoTextStyle}"
                     HorizontalAlignment="Right" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="Top" controls:Entrance.IsEnabled="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="960" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Padding="24,28,24,8" Spacing="4">
      <TextBlock x:Uid="Queue_Eyebrow" Text="Treatment queue" Style="{StaticResource EyebrowTextStyle}" />
      <mvux:FeedView Source="{Binding Stats}" IsTabStop="False">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Data.Urgent}" Style="{StaticResource DisplayLarge}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Uid="Queue_Urgent" Text="urgent" Style="{StaticResource TitleMedium}" VerticalAlignment="Bottom" Margin="0,0,0,10" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Data.Open, Converter={StaticResource CountText}, ConverterParameter=Open}" Style="{StaticResource MutedBodyTextStyle}" />
                <TextBlock Text="{Binding Data.InProgress, Converter={StaticResource CountText}, ConverterParameter=InProgress}" Style="{StaticResource MutedBodyTextStyle}" />
                <TextBlock Text="{Binding Data.ScheduledThisWeek, Converter={StaticResource CountText}, ConverterParameter=ThisWeek}" Style="{StaticResource MutedBodyTextStyle}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.ProgressTemplate>
          <DataTemplate>
            <TextBlock Text="…" Style="{StaticResource DisplayLarge}" Foreground="{ThemeResource OutlineVariantBrush}" />
          </DataTemplate>
        </mvux:FeedView.ProgressTemplate>
        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <TextBlock Text="—" Style="{StaticResource DisplayLarge}" Foreground="{ThemeResource OutlineVariantBrush}" />
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="24,8,24,8"
                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
      <utu:ChipGroup ItemsSource="{Binding Filters}"
                     SelectionMode="Single"
                     SelectedItem="{Binding Filter, Mode=TwoWay}"
                     Style="{StaticResource FilterChipGroupStyle}">
        <utu:ChipGroup.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </utu:ChipGroup.ItemTemplate>
      </utu:ChipGroup>
    </ScrollViewer>

    <mvux:FeedView x:Name="QueueFeed" Grid.Row="2" Source="{Binding Treatments}" IsTabStop="False">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ListView ItemsSource="{Binding Data}"
                    ItemTemplate="{StaticResource QueueRowTemplate}"
                    SelectionMode="None" IsItemClickEnabled="True"
                    uen:Navigation.Request="Treatment"
                    AutomationProperties.AutomationId="QueueList">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
          </ListView>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <ContentControl ContentTemplate="{StaticResource ListProgressTemplate}" Padding="24,0" />
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>
      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel Spacing="12" Padding="24,32" HorizontalAlignment="Left">
            <TextBlock x:Uid="Queue_EmptyTitle" Text="Nothing here" Style="{StaticResource TitleLarge}" />
            <TextBlock x:Uid="Queue_EmptyBody" Text="No treatments in this status. Submitted surveys propose treatments for serious and urgent findings."
                       Style="{StaticResource MutedBodyTextStyle}" MaxWidth="480" />
            <Button x:Uid="Queue_ShowOpen" Content="Show all open work" Style="{StaticResource OutlinedButtonStyle}"
                    Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ShowOpen}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Spacing="12" Padding="24,32" HorizontalAlignment="Left">
            <TextBlock x:Uid="Queue_ErrorTitle" Text="The queue could not be opened" Style="{StaticResource TitleLarge}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedBodyTextStyle}" />
            <Button x:Uid="Common_Retry" Content="Try again" Style="{StaticResource FilledButtonStyle}"
                    Command="{Binding Refresh, ElementName=QueueFeed}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
