<Page x:Class="Patina.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Patina.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    WORKAROUND(ResponsiveExtension does not reconnect after Unloaded): cached page; see MainPage.xaml.
    The data buttons stack below Normal (600 px) through an AdaptiveTrigger.
  -->
  <!-- xaml-lint: allow responsive - see WORKAROUND above -->
  <utu:SafeArea Insets="Top,SoftInput" Mode="Padding">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Normal">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="600" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="DataActions.Orientation" Value="Horizontal" />
            <Setter Target="ExportButton.HorizontalAlignment" Value="Left" />
            <Setter Target="ImportButton.HorizontalAlignment" Value="Left" />
            <Setter Target="ResetButton.HorizontalAlignment" Value="Left" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollViewer>
      <Grid>
        <!-- Left-aligned like the other top-level tabs; the column caps the reading width -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}" />
        </Grid.ColumnDefinitions>
          <StackPanel Spacing="32" Padding="24,28,24,40" controls:Entrance.IsEnabled="True">
          <StackPanel Spacing="4">
            <TextBlock x:Uid="Settings_Eyebrow" Text="Settings" Style="{StaticResource EyebrowTextStyle}" />
            <!-- Anchor: who is recording -->
            <TextBlock x:Uid="Settings_SurveyorHeading" Text="Who is surveying?" Style="{StaticResource DisplaySmall}"
                       AutomationProperties.HeadingLevel="Level1" TextWrapping="WrapWholeWords" />
            <TextBlock x:Uid="Settings_SurveyorBody" Text="Your name is stamped on every survey and log entry you make on this device."
                       Style="{StaticResource MutedBodyTextStyle}" />
            <TextBox x:Uid="Settings_Surveyor" Header="Name" Margin="0,8,0,0"
                     Text="{Binding Surveyor, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsSurveyor" />
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock x:Uid="Settings_AppearanceHeading" Text="Appearance" Style="{StaticResource SectionTitleTextStyle}" />
            <RadioButtons x:Uid="Settings_Theme" Header="Theme"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                          MaxColumns="3" AutomationProperties.AutomationId="ThemeChoice" />
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Uid="Settings_ReduceMotionLabel" Text="Reduce motion" Style="{StaticResource BodyLarge}" />
                <TextBlock x:Uid="Settings_ReduceMotionBody" Text="Pages appear without movement. Follows the system setting where the platform reports it."
                           Style="{StaticResource MutedBodyTextStyle}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsOn="{Binding ReduceMotion, Mode=TwoWay}"
                            OnContent="" OffContent="" MinWidth="0"
                            AutomationProperties.Name="Reduce motion"
                            AutomationProperties.AutomationId="ReduceMotion" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock x:Uid="Settings_LanguageHeading" Text="Language" Style="{StaticResource SectionTitleTextStyle}" />
            <RadioButtons ItemsSource="{Binding LanguageOptions}"
                          SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                          MaxColumns="2" AutomationProperties.Name="Language"
                          AutomationProperties.AutomationId="LanguageChoice" />
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock x:Uid="Settings_DataHeading" Text="Collection data" Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock x:Uid="Settings_DataBody"
                       Text="The collection lives on this device. Export it to a .patina file to back it up or move it to another device; importing replaces everything here."
                       Style="{StaticResource MutedBodyTextStyle}" />
            <StackPanel x:Name="DataActions" Orientation="Vertical" Spacing="12">
              <Button x:Name="ExportButton" x:Uid="Settings_Export" Content="Export collection" Command="{Binding Export}"
                      Style="{StaticResource FilledTonalButtonStyle}" AutomationProperties.AutomationId="Export"
                      HorizontalAlignment="Stretch" />
              <Button x:Name="ImportButton" x:Uid="Settings_Import" Content="Import collection" Command="{Binding Import}"
                      Style="{StaticResource OutlinedButtonStyle}" AutomationProperties.AutomationId="Import"
                      HorizontalAlignment="Stretch" />
              <Button x:Name="ResetButton" x:Uid="Settings_Reset" Content="Restore sample collection" Command="{Binding ResetSample}"
                      Style="{StaticResource TextButtonStyle}" Foreground="{ThemeResource ErrorBrush}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMedium}" TextWrapping="WrapWholeWords"
                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="SettingsMessage"
                       Visibility="{Binding Message, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock x:Uid="Settings_AboutHeading" Text="About" Style="{StaticResource SectionTitleTextStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Patina" Style="{StaticResource TitleSmall}" />
              <TextBlock Text="{Binding Version}" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Uid="Settings_AboutSample" Text="The sample collection is fictional: invented works and artists placed at real Montréal sites."
                       Style="{StaticResource MutedBodyTextStyle}" />
            <TextBlock x:Uid="Settings_AboutCredits" Text="Map data © OpenStreetMap contributors (ODbL). IBM Plex typefaces under the SIL Open Font License."
                       Style="{StaticResource MutedBodyTextStyle}" />
            <StackPanel Spacing="2" Margin="0,8,0,0">
              <TextBlock x:Uid="Settings_DataFolder" Text="Data folder" Style="{StaticResource LabelMedium}" />
              <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </utu:SafeArea>
</Page>
