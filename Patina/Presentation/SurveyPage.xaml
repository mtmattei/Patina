<Page x:Class="Patina.Presentation.SurveyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Patina.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <DataTemplate x:Key="SurveyPhotoTemplate">
      <Grid Width="96" Height="96">
        <!-- xaml-lint: allow card - clips a photo thumbnail; the fill shows while it loads -->
        <Border CornerRadius="6" Background="{ThemeResource SurfaceVariantBrush}">
          <Image controls:PhotoSource.FileName="{Binding FileName}" Stretch="UniformToFill"
                 AutomationProperties.Name="{Binding OriginalName}" />
        </Border>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                AutomationProperties.Name="Remove photo"
                Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.RemoveSurveyPhoto}"
                CommandParameter="{Binding}">
          <FontIcon Glyph="&#xE711;" FontSize="12" />
        </Button>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="FindingPhotoTemplate">
      <Grid Width="72" Height="72">
        <!-- xaml-lint: allow card - clips a photo thumbnail; the fill shows while it loads -->
        <Border CornerRadius="6" Background="{ThemeResource SurfaceVariantBrush}">
          <Image controls:PhotoSource.FileName="{Binding FileName}" Stretch="UniformToFill"
                 AutomationProperties.Name="{Binding OriginalName}" />
        </Border>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                AutomationProperties.Name="Remove photo"
                Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.RemoveFindingPhoto}"
                CommandParameter="{Binding}">
          <FontIcon Glyph="&#xE711;" FontSize="12" />
        </Button>
      </Grid>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="HorizontalPanel">
      <StackPanel Orientation="Horizontal" Spacing="8" />
    </ItemsPanelTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar x:Uid="Survey_Title" Content="Condition survey"
                       MainCommandMode="Action" utu:SafeArea.Insets="Top">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="Survey_Back" Label="Back" Command="{Binding Close}"
                      AutomationProperties.AutomationId="SurveyBack">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE72B;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <utu:SafeArea Grid.Row="1" Insets="Bottom,SoftInput" Mode="Padding">
      <ScrollViewer>
        <Grid>
          <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Spacing="28" Padding="24,20,24,40" controls:Entrance.IsEnabled="True">

            <mvux:FeedView Source="{Binding Header}" IsTabStop="False">
              <DataTemplate>
                <controls:TombstoneLabel Style="{StaticResource CompactTombstoneLabelStyle}"
                                         Accession="{Binding Data.Artwork.Accession}"
                                         Title="{Binding Data.Artwork.Title}"
                                         Byline="{Binding Data.Artwork, Converter={StaticResource PlaceText}}" />
              </DataTemplate>
            </mvux:FeedView>

            <!-- Anchor: the grade this survey will submit with -->
            <StackPanel Spacing="8">
              <TextBlock x:Uid="Survey_GradeHeading" Text="Grade from findings" Style="{StaticResource EyebrowTextStyle}" />
              <controls:ConditionStrip Grade="{Binding LiveGrade}" Style="{StaticResource LargeConditionStripStyle}"
                                       AutomationProperties.AutomationId="LiveGrade" />
              <TextBlock x:Uid="Survey_GradeRule" Text="The worst finding sets the grade. Three moderate findings count as Poor."
                         Style="{StaticResource MutedBodyTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="12">
              <TextBlock x:Uid="Survey_DetailsHeading" Text="Survey" Style="{StaticResource SectionTitleTextStyle}" />
              <TextBox x:Uid="Survey_Surveyor" Header="Surveyor" Text="{Binding Form.Surveyor, Mode=TwoWay}"
                       AutomationProperties.AutomationId="Surveyor" />
              <StackPanel Spacing="4">
                <TextBlock x:Uid="Survey_WeatherLabel" Text="Weather" Style="{StaticResource LabelLarge}" />
                <ComboBox ItemsSource="{Binding WeatherOptions}"
                          SelectedIndex="{Binding Form.WeatherIndex, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Weather" />
              </StackPanel>
              <TextBox x:Uid="Survey_Notes" Header="General notes" Text="{Binding Form.Notes, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />
              <StackPanel Spacing="8">
                <TextBlock x:Uid="Survey_OverviewPhotos" Text="Overview photographs" Style="{StaticResource LabelLarge}" />
                <ItemsControl ItemsSource="{Binding SurveyPhotos}" ItemsPanel="{StaticResource HorizontalPanel}"
                              ItemTemplate="{StaticResource SurveyPhotoTemplate}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Style="{StaticResource OutlinedButtonStyle}" Command="{Binding AddSurveyPhoto}"
                          AutomationProperties.AutomationId="AddSurveyPhoto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                      <TextBlock x:Uid="Survey_AddPhoto" Text="Add photo" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource OutlinedButtonStyle}" Command="{Binding CaptureSurveyPhoto}"
                          Visibility="{Binding CanCapture, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE722;" FontSize="16" />
                      <TextBlock x:Uid="Survey_TakePhoto" Text="Take photo" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock x:Uid="Survey_FindingsHeading" Text="Findings" Style="{StaticResource SectionTitleTextStyle}" />
              <TextBlock x:Uid="Survey_NoFindings" Text="No findings yet. A survey with no findings submits as Good."
                         Style="{StaticResource MutedBodyTextStyle}"
                         Visibility="{Binding Findings, Converter={StaticResource VisibleWhen}, ConverterParameter=invert, FallbackValue=Collapsed}" />
              <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Converter={StaticResource FindingText}}" Style="{StaticResource TitleSmall}" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding Note}" Style="{StaticResource MutedBodyTextStyle}"
                                   Visibility="{Binding Note, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                        <TextBlock Text="{Binding PhotoIds, Converter={StaticResource CountText}, ConverterParameter=Photos}"
                                   Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   Visibility="{Binding PhotoIds, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                      </StackPanel>
                      <Button Grid.Column="1" x:Uid="Survey_RemoveFinding" Content="Remove"
                              Style="{StaticResource TextButtonStyle}" VerticalAlignment="Top"
                              Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.RemoveFinding}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <StackPanel Spacing="12" Padding="20">
                  <TextBlock x:Uid="Survey_AddFindingHeading" Text="Add a finding" Style="{StaticResource TitleMedium}" />
                  <StackPanel Spacing="4">
                    <TextBlock x:Uid="Survey_FindingTypeLabel" Text="Type" Style="{StaticResource LabelLarge}" />
                    <ComboBox x:Uid="Survey_FindingType"
                              PlaceholderText="Choose a type"
                              ItemsSource="{Binding FindingTypes}"
                              SelectedIndex="{Binding NewFinding.TypeIndex, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Finding type"
                              AutomationProperties.AutomationId="FindingType" />
                  </StackPanel>
                  <TextBox x:Uid="Survey_FindingZone" Header="Where on the object"
                           PlaceholderText="North face, base, left hand…"
                           Text="{Binding NewFinding.Zone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.AutomationId="FindingZone" />
                  <RadioButtons x:Uid="Survey_FindingSeverity" Header="Severity"
                                ItemsSource="{Binding SeverityOptions}"
                                SelectedIndex="{Binding NewFinding.SeverityIndex, Mode=TwoWay}"
                                MaxColumns="{utu:Responsive Narrowest=2, Normal=4}"
                                AutomationProperties.AutomationId="FindingSeverity" />
                  <TextBox x:Uid="Survey_FindingNote" Header="Note" Text="{Binding NewFinding.Note, Mode=TwoWay}"
                           AcceptsReturn="True" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding FindingPhotos}" ItemsPanel="{StaticResource HorizontalPanel}"
                                ItemTemplate="{StaticResource FindingPhotoTemplate}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource TextButtonStyle}" Command="{Binding AddFindingPhoto}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                        <TextBlock x:Uid="Survey_AddPhoto" Text="Add photo" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TextButtonStyle}" Command="{Binding CaptureFindingPhoto}"
                            Visibility="{Binding CanCapture, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" FontSize="16" />
                        <TextBlock x:Uid="Survey_TakePhoto" Text="Take photo" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <Button x:Uid="Survey_AddFinding" Content="Add finding"
                          Style="{StaticResource FilledTonalButtonStyle}"
                          Command="{Binding AddFinding}"
                          AutomationProperties.AutomationId="AddFinding" />
                </StackPanel>
              </utu:CardContentControl>
            </StackPanel>

            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMedium}" TextWrapping="WrapWholeWords"
                         Foreground="{ThemeResource OnSurfaceBrush}"
                         AutomationProperties.LiveSetting="Assertive"
                         AutomationProperties.AutomationId="SurveyMessage"
                         Visibility="{Binding Message, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
              <StackPanel Orientation="{utu:Responsive Narrowest=Vertical, Normal=Horizontal}" Spacing="12">
                <Button x:Uid="Survey_Submit" Content="Submit survey" Style="{StaticResource FilledButtonStyle}"
                        Command="{Binding Submit}" AutomationProperties.AutomationId="SubmitSurvey"
                        HorizontalAlignment="{utu:Responsive Narrowest=Stretch, Normal=Left}" />
                <Button x:Uid="Survey_SaveDraft" Content="Save draft" Style="{StaticResource OutlinedButtonStyle}"
                        Command="{Binding SaveDraft}" AutomationProperties.AutomationId="SaveDraft"
                        HorizontalAlignment="{utu:Responsive Narrowest=Stretch, Normal=Left}" />
                <Button x:Uid="Survey_Discard" Content="Discard draft" Style="{StaticResource TextButtonStyle}"
                        Command="{Binding Discard}" Foreground="{ThemeResource ErrorBrush}"
                        HorizontalAlignment="{utu:Responsive Narrowest=Stretch, Normal=Left}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </utu:SafeArea>
  </Grid>
</Page>
