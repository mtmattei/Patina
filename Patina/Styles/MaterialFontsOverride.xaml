<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Material controls (buttons, text boxes, chips) render IBM Plex Sans instead of Roboto. Weights resolve through the font manifest. -->
  <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/IBMPlexSans.ttf</FontFamily>
  <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/IBMPlexSans.ttf</FontFamily>
  <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/IBMPlexSans.ttf</FontFamily>
</ResourceDictionary>
