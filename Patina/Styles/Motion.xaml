<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- House motion values (xaml-design-polish). Use only these; no one-off curves or durations. -->
  <KeySpline x:Key="EaseSmooth">0.22,1 0.36,1</KeySpline>
  <KeySpline x:Key="EaseOut">0.17,1 0.32,1</KeySpline>
  <KeySpline x:Key="EaseInOut">0.66,0 0.34,1</KeySpline>

  <Duration x:Key="DurationFast">0:0:0.15</Duration>
  <Duration x:Key="DurationNormal">0:0:0.2</Duration>
  <Duration x:Key="DurationSlow">0:0:0.28</Duration>
  <x:Double x:Key="DurationFastMs">150</x:Double>
  <x:Double x:Key="DurationNormalMs">200</x:Double>
  <x:Double x:Key="DurationSlowMs">280</x:Double>

  <x:Double x:Key="EntranceRise">6</x:Double>
  <x:Double x:Key="PressScale">0.98</x:Double>
</ResourceDictionary>
