<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Patina.Controls"
                    xmlns:converters="using:Patina.Converters"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!-- Converters -->
  <converters:EnumTextConverter x:Key="EnumText" />
  <converters:DateTextConverter x:Key="DateText" />
  <converters:VisibleWhenConverter x:Key="VisibleWhen" />
  <converters:DueTextConverter x:Key="DueText" />
  <converters:GradeTextConverter x:Key="GradeText" />
  <converters:NextActionTextConverter x:Key="NextActionText" />
  <converters:LogTextConverter x:Key="LogText" />
  <converters:CountTextConverter x:Key="CountText" />
  <converters:DateOnlyOffsetConverter x:Key="DateOnlyOffset" />
  <converters:BylineTextConverter x:Key="BylineText" />
  <converters:PlaceTextConverter x:Key="PlaceText" />
  <converters:IntervalTextConverter x:Key="IntervalText" />
  <converters:SurveyActionTextConverter x:Key="SurveyActionText" />
  <converters:FindingTextConverter x:Key="FindingText" />
  <converters:SurveyMetaTextConverter x:Key="SurveyMetaText" />

  <!-- Lightweight styling: cards follow the radius token -->
  <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

  <!-- Breakpoints: the toolkit defaults (150/300/600/800/1080) are the app's bands. -->
  <x:Double x:Key="ContentMaxWidth">760</x:Double>
  <x:Double x:Key="ListPaneWidth">440</x:Double>

  <!-- Text roles derived from the generated ramp -->
  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="MutedBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>
  <Style x:Key="AccessionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>
  <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- The condition strip: the app's signature. Keyed base so size variants can be BasedOn it. -->
  <Style x:Key="DefaultConditionStripStyle" TargetType="controls:ConditionStrip">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ConditionStrip">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
              <Rectangle x:Name="P1" RadiusX="2" RadiusY="2"
                         Width="{TemplateBinding PatchWidth}" Height="{TemplateBinding PatchHeight}"
                         Fill="{ThemeResource OutlineVariantBrush}" />
              <Rectangle x:Name="P2" RadiusX="2" RadiusY="2"
                         Width="{TemplateBinding PatchWidth}" Height="{TemplateBinding PatchHeight}"
                         Fill="{ThemeResource OutlineVariantBrush}" />
              <Rectangle x:Name="P3" RadiusX="2" RadiusY="2"
                         Width="{TemplateBinding PatchWidth}" Height="{TemplateBinding PatchHeight}"
                         Fill="{ThemeResource OutlineVariantBrush}" />
              <Rectangle x:Name="P4" RadiusX="2" RadiusY="2"
                         Width="{TemplateBinding PatchWidth}" Height="{TemplateBinding PatchHeight}"
                         Fill="{ThemeResource OutlineVariantBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Visibility="{Binding ShowLabel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleWhen}}">
              <TextBlock x:Name="Number" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource OnSurfaceBrush}" />
              <TextBlock x:Name="Word" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="GradeStates">
                <VisualState x:Name="Grade0" />
                <VisualState x:Name="Grade1">
                  <VisualState.Setters>
                    <Setter Target="P1.Fill" Value="{StaticResource Grade1InvariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Grade2">
                  <VisualState.Setters>
                    <Setter Target="P1.Fill" Value="{StaticResource Grade2InvariantBrush}" />
                    <Setter Target="P2.Fill" Value="{StaticResource Grade2InvariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Grade3">
                  <VisualState.Setters>
                    <Setter Target="P1.Fill" Value="{StaticResource Grade3InvariantBrush}" />
                    <Setter Target="P2.Fill" Value="{StaticResource Grade3InvariantBrush}" />
                    <Setter Target="P3.Fill" Value="{StaticResource Grade3InvariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Grade4">
                  <VisualState.Setters>
                    <Setter Target="P1.Fill" Value="{StaticResource Grade4InvariantBrush}" />
                    <Setter Target="P2.Fill" Value="{StaticResource Grade4InvariantBrush}" />
                    <Setter Target="P3.Fill" Value="{StaticResource Grade4InvariantBrush}" />
                    <Setter Target="P4.Fill" Value="{StaticResource Grade4InvariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:ConditionStrip" BasedOn="{StaticResource DefaultConditionStripStyle}" />

  <Style x:Key="LargeConditionStripStyle" TargetType="controls:ConditionStrip" BasedOn="{StaticResource DefaultConditionStripStyle}">
    <Setter Property="PatchWidth" Value="22" />
    <Setter Property="PatchHeight" Value="30" />
  </Style>

  <!-- The object label -->
  <Style TargetType="controls:TombstoneLabel">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:TombstoneLabel">
          <StackPanel Spacing="4">
            <utu:Divider Margin="0,0,0,8" Foreground="{ThemeResource OutlineBrush}" />
            <TextBlock Text="{TemplateBinding Accession}" Style="{StaticResource AccessionTextStyle}" IsTextSelectionEnabled="True" />
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource DisplayMedium}" TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
            <TextBlock Text="{TemplateBinding Byline}" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" />
            <TextBlock Text="{TemplateBinding Place}" Style="{StaticResource MutedBodyTextStyle}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CompactTombstoneLabelStyle" TargetType="controls:TombstoneLabel">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:TombstoneLabel">
          <StackPanel Spacing="2">
            <TextBlock Text="{TemplateBinding Accession}" Style="{StaticResource AccessionTextStyle}" />
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource HeadlineSmall}" TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
            <TextBlock Text="{TemplateBinding Byline}" Style="{StaticResource MutedBodyTextStyle}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Data-state templates shared by every FeedView -->
  <DataTemplate x:Key="ListProgressTemplate">
    <StackPanel Spacing="12" Padding="0,16" AutomationProperties.Name="Loading">
      <ProgressBar IsIndeterminate="True" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
